{
  "name": "lollipop/kid-carpool",
  "description": "Laravel backend for a kid-safe carpooling app",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-install-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
